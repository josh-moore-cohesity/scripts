# Copy to terraform.tfvars and fill in, or (preferred) set via env vars:
#   export TF_VAR_target_cluster_id="1234567890123456"

target_cluster_id     = "1234567890123456"  # clusterId, not the cluster VIP -- see ../example-helios
key_vault_name        = "my-keyvault"
key_vault_secret_name = "helios-api-key"

vm_name             = "my-vm-01"
policy_name         = "Gold"
storage_domain_name = "DefaultStorageDomain"

# Leave false for the first apply (lookups only). Flip to true for one
# apply to create the job, then flip back to false.
create_job = false
